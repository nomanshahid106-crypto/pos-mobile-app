# Copy to .env (Expo reads EXPO_PUBLIC_* at build time). Never commit real secrets.
# Publishable/anon key ONLY. NEVER put the service-role key in the mobile app.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key
# Optional: label shown for manual/card payments when no gateway is configured
EXPO_PUBLIC_PAYMENT_MODE=manual
